#!/usr/bin/env bash
# The registry's stand-in for kiewer_lib/tests/it/prune_images.rs, over the
# fixture's files under PRUNE_FIXTURE_ROOT. It takes exactly the two
# spellings the script is meant to use; anything else fails the run.
# Tracked and put on PATH where it lies; the test file's module doc says
# why it is never written by a test.
set -euo pipefail
root="${PRUNE_FIXTURE_ROOT:?set PRUNE_FIXTURE_ROOT}"
# a-project is the GCP_PROJECT_ID the tests give the script.
image=europe-west4-docker.pkg.dev/a-project/kiewer/kiewer
case "$*" in
  "artifacts docker tags list $image --format=value(tag.basename())")
    cat "$root/registry"
    ;;
  "artifacts docker tags delete $image:"*" --quiet")
    tag="${5##*:}"
    grep -Fxq "$tag" "$root/registry" || { echo "NOT_FOUND: $tag" >&2; exit 1; }
    [ ! -e "$root/refuse-deletes" ] || { echo "PERMISSION_DENIED: $tag" >&2; exit 1; }
    { grep -vFx "$tag" "$root/registry" || true; } > "$root/registry.next"
    mv "$root/registry.next" "$root/registry"
    echo "$tag" >> "$root/deleted"
    ;;
  *)
    echo "gcloud stand-in: unexpected call: $*" >&2
    exit 64
    ;;
esac
