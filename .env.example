# Copy to .env (git-ignored) and export it before `cargo run` or
# `scripts/checks.sh test`; every variable is read once at startup by
# kiewer_lib::config. The Postgres triple matches compose.yaml.
DATABASE_URL=postgres://kiewer:kiewer@127.0.0.1:5432/kiewer
# PORT=8090
# KIEWER_BLOB_DIR=blobs
# A GCS bucket instead of the directory; with the emulator (README,
# Development) beside it, the GCS store runs against that.
# BLOB_BUCKET=
# KIEWER_GCS_EMULATOR=http://127.0.0.1:8092
# RUST_LOG=info
# The log's shape: json (one object per event, the shape Cloud Logging
# reads into jsonPayload and the renderer beacon's metric counts) or text.
# Unset, a terminal on stdout gets text and anything else json.
# LOG_FORMAT=text
# Sign-in: a development OAuth app of your own per provider (README,
# Development); each pair both or neither, named as infra/ hands them to
# Cloud Run. A provider without its pair is left off the front page. The
# callback URL registered there is PUBLIC_URL + /auth/<provider>/callback.
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_DISCORD_CLIENT_ID=
# OAUTH_DISCORD_CLIENT_SECRET=
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# PUBLIC_URL=http://localhost:8090
