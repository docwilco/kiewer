# Copy to .env (git-ignored) and export it before `cargo run` or
# `scripts/checks.sh test`; every variable is read once at startup by
# kiewer_lib::config. The Postgres triple matches compose.yaml.
DATABASE_URL=postgres://kiewer:kiewer@127.0.0.1:5432/kiewer
# PORT=8080
# KIEWER_BLOB_DIR=blobs
# A GCS bucket instead of the directory; with the emulator (README,
# Development) beside it, the GCS store runs against that.
# BLOB_BUCKET=
# KIEWER_GCS_EMULATOR=http://127.0.0.1:4443
# RUST_LOG=info
# Sign-in with GitHub: a development OAuth app of your own (README,
# Development); both or neither. The callback URL registered there is
# KIEWER_PUBLIC_URL + /auth/github/callback.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# KIEWER_PUBLIC_URL=http://localhost:8080
