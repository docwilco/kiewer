.env
/target
# the viewer for the browser, written by scripts/build-viewer.sh and
# embedded by kiewer_lib/build.rs
/kiewer_viewer/dist
# the filesystem blob store of a dev box (KIEWER_BLOB_DIR, default)
/blobs
# Terraform (infra/): the providers, plans and the operator's variables stay
# local; .terraform.lock.hcl is committed, it pins the providers.
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/*.tfplan
infra/terraform.tfvars
infra/*.auto.tfvars
