{
  "db_name": "PostgreSQL",
  "query": "SELECT d.id AS \"id!: crate::design::DesignId\",\n    d.owner_id AS \"owner_id!: crate::account::AccountId\",\n    d.slug AS \"slug!\", d.name AS \"name!\", d.default_branch AS \"default_branch!\",\n    d.visibility AS \"visibility!\", a.handle AS \"handle!\", p.branch, p.base_hash, p.message,\n                p.warnings,\n                CEIL(EXTRACT(EPOCH FROM p.expires_at - now()) / 60)::bigint AS \"minutes_left!\"\n         FROM pending_revision p\n         JOIN design d ON d.id = p.design_id\n         JOIN account a ON a.id = d.owner_id\n         WHERE p.id = $1 AND p.author_id = $2 AND p.expires_at > now()",
