#!/usr/bin/env bash
# Tracked pre-commit hook. Enable once per clone:
#   git config core.hooksPath .githooks
#
# The checks run against a snapshot of the index, in a directory of its own,
# never against the working tree. Two consequences:
#
#   * the hook validates exactly what the commit will contain, so unstaged
#     edits can neither break a good commit nor rescue a broken one;
#   * the snapshot builds into its own target directory, so you can keep
#     editing and running cargo in the working tree while the hook runs.
#
# Everything CI runs, from the single source: scripts/checks.sh
set -euo pipefail

# Directories nothing cargo builds lives under. A commit that touches only
# these, or markdown files at the root, runs no checks: the snapshot below
# could not come out red, the run would only cost the minute. Add a local
# issue tracker's directory (.scratch) when the repo has one.
prose_dirs=(docs viewer-drop)

# No staged path at all counts as code: `git commit --amend` with nothing
# staged lists none, since the index matches the commit being amended, and
# still commits that commit's whole tree (#79).
staged="$(git diff --cached --name-only)"
prose_only=0
if [ -n "$staged" ]; then
  prose_only=1
  while IFS= read -r path; do
    under_prose=0
    for dir in "${prose_dirs[@]}"; do
      case "$path" in "$dir"/*) under_prose=1 ;; esac
    done
    [ "$under_prose" = 1 ] && continue
    case "$path" in
      */*) prose_only=0; break ;;
      *.md) ;;
      *) prose_only=0; break ;;
    esac
  done <<<"$staged"
fi
if [ "$prose_only" = 1 ]; then
  echo "pre-commit: prose only (${prose_dirs[*]}/, root *.md); checks skipped."
  exit 0
fi

command -v rsync >/dev/null || {
  echo "pre-commit: rsync is required (apt install rsync)." >&2
  exit 1
}

git_dir="$(git rev-parse --absolute-git-dir)"
root="$(git rev-parse --show-toplevel)"

# The snapshot lives in the worktree's git directory (.git for the main
# checkout, .git/worktrees/<id> for a linked one), so `git worktree remove`
# and `git worktree prune` delete it with the worktree. A directory of its own
# outside the repository outlived every removed worktree: one per agent, 15
# to 25 GiB each, never swept again. The snapshot's Cargo.toml declares
# [workspace], so cargo treats it as a root of its own and never claims it
# for the checkout's workspace; what cargo does read from above is a
# .cargo/config.toml in the checkout, which the snapshot's own copy
# overrides key by key. Deleting the directory is always safe; the next
# commit rebuilds it, cold.
snapshot="$git_dir/pre-commit-snapshot"

# One commit at a time per worktree: concurrent runs would race on the
# snapshot directory and on its build lock.
exec 9>"$snapshot.lock"
flock -n 9 || {
  echo "pre-commit: another commit is already running its checks here." >&2
  exit 1
}

# The checkout's own target is swept here (.githooks/sweep.sh says how),
# before the target is pinned below, so the sweep sees whatever
# this shell builds into.
. "$(dirname "${BASH_SOURCE[0]}")/sweep.sh"
sweep_checkout pre-commit "$root"

# Export the index git is about to commit. Git points GIT_INDEX_FILE at a
# temporary index for partial commits, and checkout-index honours it, so the
# snapshot tracks the real commit content in every commit mode.
export_dir="$(mktemp -d "$git_dir/pre-commit-export.XXXXXX")"
trap 'rm -rf "$export_dir"' EXIT
git checkout-index --all --force --prefix="$export_dir/"

# Sync the export onto the persistent snapshot. The export stamps every file
# with the current time; --checksum transfers only files whose content really
# changed, and leaving -t off means the untouched ones keep their old mtimes,
# so cargo rebuilds only what moved. -p keeps the executable bits.
mkdir -p "$snapshot"
rsync -rp --checksum --delete --exclude='/target' "$export_dir/" "$snapshot/"

# Never share a build directory with the working tree. The snapshot's own
# target is cargo's default for the snapshot's workspace, so the variables
# that move it are unset, never pointed there: sccache puts every CARGO_*
# variable in its cache key, and one naming this worktree's snapshot gave
# every worktree a compile cache of its own, cold on its first commit. A
# config file can still move it, which the check below refuses; where cargo
# cannot say (no metadata), the checks' own cargo fails first. The exclude
# above keeps --delete off this path.
unset CARGO_TARGET_DIR CARGO_BUILD_TARGET_DIR
target_dir="$snapshot/target"
if actual_target="$(cd "$snapshot" &&
  cargo metadata --format-version 1 --no-deps 2>/dev/null | jq -r .target_directory)" &&
  [ "$actual_target" != "$target_dir" ]; then
  echo "pre-commit: cargo builds the snapshot into $actual_target, not" >&2
  echo "  $target_dir; a config file sets build.target-dir." >&2
  exit 1
fi

# The snapshot's target is swept by use, not age: a stamp before the checks,
# and once they pass everything they did not touch goes. Cargo marks a fresh
# unit as used only with mtime-on-use, an unstable switch stable cargo takes
# with RUSTC_BOOTSTRAP=1 in the environment. The price is that rustc in the
# snapshot would accept a feature gate stable refuses, and proc-macro2
# builds with its unstable span API; CI on plain stable is the backstop.
# Changing the variable between runs reruns every build script that watches
# it, so it is set on every run, sweep or no sweep. The stamp file lands in
# the snapshot root; the sweep consumes it, and after a failed run the rsync
# above deletes it, so nothing older than the run in hand is ever read.
export RUSTC_BOOTSTRAP=1 CARGO_UNSTABLE_MTIME_ON_USE=true
have_sweep=0
if command -v cargo-sweep >/dev/null; then
  have_sweep=1
  cargo sweep --stamp "$snapshot"
fi

# sccache shares a compile between worktrees only when the paths in it are
# stripped to the same ones; SCCACHE_BASEDIRS names the prefix to strip.
# The server, not the rustc wrapper, does the hashing, and it reads the
# variable once, when it starts (mozilla/sccache#2984 would read it per
# compile), so a server every checkout shares strips only the path of the
# build that started it. The checks get a server of their own, started with
# the snapshot as its base directory, on a socket in the snapshot, sharing
# the disk cache with every other server; it stops when the checks end. A
# client that finds it gone mid-run (its idle timeout) starts another with
# the same environment. Stripping the env!("OUT_DIR") value that
# serde_core, thiserror and serde_json read, a miss every crate above them
# inherits, takes an sccache after 0.19.0 (mozilla/sccache#2918). Where the
# server cannot start (no sccache, a socket path past the limit), the
# checks use whatever compiler wrapper cargo is set up with.
server=0
if command -v sccache >/dev/null; then
  export SCCACHE_SERVER_UDS="$snapshot/.sccache.sock" SCCACHE_BASEDIRS="$snapshot"
  rm -f "$SCCACHE_SERVER_UDS"
  if sccache --start-server >/dev/null 2>&1 9>&-; then
    server=1
  else
    unset SCCACHE_SERVER_UDS SCCACHE_BASEDIRS
  fi
fi
stop_server() {
  [ "$server" = 1 ] || return 0
  sccache --show-stats | awk '
    /^Cache hits  /{h=$3} /^Cache misses  /{m=$3} /^Non-cacheable calls/{n=$3}
    END{printf "pre-commit: sccache %d hits, %d misses, %d not cacheable\n", h, m, n}'
  sccache --stop-server >/dev/null 2>&1 || true
  rm -f "$SCCACHE_SERVER_UDS"
}

# 9>&- keeps the lock fd out of the checks and everything they spawn, the
# sccache server above included. Without it a test daemon that outlives its
# run inherits the lock and blocks the next commit, long after the hook that
# took it has exited.
echo "pre-commit: checking the staged tree in $snapshot"
bash "$snapshot/scripts/checks.sh" all 9>&- || {
  stop_server
  echo >&2
  echo "pre-commit: checks failed against the staged tree, which is still in" >&2
  echo "  $snapshot" >&2
  echo "Reproduce there: (cd $snapshot && scripts/checks.sh <stage>)" >&2
  exit 1
}
stop_server

sweep_incremental pre-commit "$target_dir"
if [ "$have_sweep" = 1 ]; then
  cargo sweep --file "$snapshot"
fi
